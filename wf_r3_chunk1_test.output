  bash -lc './run_next_chunk_sequence.sh _run300.json wf_r3_chunk 60'
```

or manually one-by-one:

```bash
for i in 1 2 3 4 5; do
  bash -lc "${WORKFLOW_CMD} \"Workflow({scriptPath:'wf_r3_chunk${i}.js'})\"" > wf_r3_chunk${i}.output 2>&1 || true
