hema: SCHEMA })\nwf_r3_chunk1.js:58:phase('Research')\nwf_r3_chunk1.js:60:  agent(prompt(it), { label: `ibis:${it.slug}`, phase: 'Research', schema: SCHEMA })\nwf_r3_next_chunk3.js:58:phase('Research')\nwf_r3_next_chunk3.js:60:  agent(prompt(it), { label: `ibis:${it.slug}`, phase: 'Research', schema: SCHEMA })\nwf_ibis_next_chunk3.js:58:phase('Research')\nwf_ibis_next_chunk3.js:60:  agent(prompt(it), { label: `ibis:${it.slug}`, phase: 'Research', schema: SCHEMA })\nwf_r3_chunk2.js:58:phase('Research')\nwf_r3_chunk2.js:60:  agent(prompt(it), { label: `ibis:${it.slug}`, phase: 'Research', schema: SCHEMA })\nHANDOFF_WORKER.md:74:    open(f'wf_r3_chunk{i+1}.js','w').write(s); print(i+1,len(lite))\nHANDOFF_WORKER.md:77:- Fire chunks **one at a time** (`Workflow({scriptPath:'wf_r3_chunk1.js'})`). When each completes, **harvest to disk**:\nwf_r3_next_chunk1.js:58:phase('Research')\nwf_r3_next_chunk1.js:60:  agent(prompt(it), { label: `ibis:${it.slug}`, phase: 'Research', schema: SCHEMA })\nwf_r2_chunk5.js:59:phase('Research')\nwf_r2_chunk5.js:61:  agent(prompt(it), { label: `ibis:${it.slug}`, phase: 'Research', schema: SCHEMA })\nwf_r3_chunk1_retry.js:58:phase('Research')\nwf_r3_chunk1_retry.js:60:  agent(prompt(it), { label: `ibis:${it.slug}`, phase: 'Research', schema: SCHEMA })\nwf_r2_chunk3.js:59:phase('Research')\nwf_r2_chunk3.js:61:  agent(prompt(it), { label: `ibis:${it.slug}`, phase: 'Research', schema: SCHEMA })\nwf_r2_chunk1.js:59:phase('Research')\nwf_r2_chunk1.js:61:  agent(prompt(it), { label: `ibis:${it.slug}`, phase: 'Research', schema: SCHEMA })\nwf_ibis_next_chunk2.js:58:phase('Research')\nwf_ibis_next_chunk2.js:60:  agent(prompt(it), { label: `ibis:${it.slug}`, phase: 'Research', schema: SCHEMA })\nwf_r3_chunk4.js:58:phase('Research')\nwf_r3_chunk4.js:60:  agent(prompt(it), { label: `ibis:${it.slug}`, phase: 'Research', schema: SCHEMA })\nwf_r3_next_chunk4.js:58:phase('Research')\nwf_r3_next_chunk4.js:60:  agent(prompt(it), { label: `ibis:${it.slug}`, pha