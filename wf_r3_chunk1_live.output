succeeded in 0ms:\nexport const meta = {\n  name: 'ibis-r3-nextchunk1',\n  description: 'Deep 2025-2026 web-researched plain-English briefs for a batch of US IBIS industries (model-agnostic workflow)',\n  phases: [{ title: 'Research', detail: 'one model-configured agent per industry: read 2022 baseline + web-research current' }],\n}\n\n// args = { items: [ { title, slug, file } ... ] }\nconst items = [{\"title\": \"3D Printing & Rapid Prototyping Services\", \"slug\": \"3d-printing-rapid-prototyping-services\", \"file\": \"txt_full/3d-printing-rapid-prototyping-services.txt\"}, {\"title\": \"AD&D Insurance\", \"slug\": \"ad-d-insurance\", \"file\": \"txt_full/ad-d-insurance.txt\"}, {\"title\": \"ATV, Golf Cart & Snowmobile Manufacturing in the US\", \"slug\": \"atv-golf-cart-snowmobile-manufacturing-in-the-us\", \"file\": \"txt_full/atv-golf-cart-snowmobile-manufacturing-in-the-us.txt\"}, {\"title\": \"Abrasive & Sandpaper Manufacturing in the US\", \"slug\": \"abrasive-sandpaper-manufacturing-in-the-us\", \"file\": \"txt_full/abrasive-sandpaper-manufacturing-in-the-us.txt\"}, {\"title\": \"Acoustic & Electric Guitar Manufacturing\", \"slug\": \"acoustic-electric-guitar-manufacturing\", \"file\": \"txt_full/acoustic-electric-guitar-manufacturing.txt\"}, {\"title\": \"Adjustable Bed & Mattress Manufacturing\", \"slug\": \"adjustable-bed-mattress-manufacturing\", \"file\": \"txt_full/adjustable-bed-mattress-manufacturing.txt\"}, {\"title\": \"Adoption & Child Welfare Services in the US\", \"slug\": \"adoption-child-welfare-services-in-the-us\", \"file\": \"txt_full/adoption-child-welfare-services-in-the-us.txt\"}, {\"title\": \"Adult & Pornographic Websites\", \"slug\": \"adult-pornographic-websites\", \"file\": \"txt_full/adult-pornographic-websites.txt\"}, {\"title\": \"Air & Gas Compressor Manufacturing\", \"slug\": \"air-gas-compressor-manufacturing\", \"file\": \"txt_full/air-gas-compressor-manufacturing.txt\"}, {\"title\": \"Air Gun & Airsoft Gun Manufacturing\", \"slug\": \"air-gun-airsoft-gun-manufacturing\", \"file\": \"txt_full/air-gun-airsoft-gun-manufacturing.txt\"}, {\"title\": \"Aircraft Maintenance, Repair & Overhaul in the US\", \"slug\": \"aircraft-maintenance-repair-overhaul-in-the-us\", \"file\": \"txt_full/aircraft-maintenance-repair-overhaul-in-the-us.txt\"}, {\"title\": \"Aircraft, Engine & Parts Manufacturing in the US\", \"slug\": \"aircraft-engine-parts-manufacturing-in-the-us\", \"file\": \"txt_full/aircraft-engine-parts-manufacturing-in-the-us.txt\"}, {\"title\": \"Aircraft, Marine & Railroad Transportation Equipment Wholesaling in the US\", \"slug\": \"aircraft-marine-railroad-transportation-equipment-wholesaling-in-the-us\", \"file\": \"txt_full/aircraft-marine-railroad-transportation-equipment-wholesaling-in-the-us.txt\"}, {\"title\": \"Alarm, Horn & Traffic Control Equipment Manufacturing in the US\", \"slug\": \"alarm-horn-traffic-control-equipment-manufacturing-in-the-us\", \"file\": \"txt_full/alarm-horn-traffic-control-equipment-manufacturing-in-the-us.txt\"}, {\"title\": \"Allergy Medicine Manufacturing OTC\", \"slug\": \"allergy-medicine-manufacturing-otc\", \"file\": \"txt_full/allergy-medicine-manufacturing-otc.txt\"}, {\"title\": \"Ambulance Manufacturing\", \"slug\": \"ambulance-manufacturing\", \"file\": \"txt_full/ambulance-manufacturing.txt\"}, {\"title\": \"Animal Food Production in the US\", \"slug\": \"animal-food-production-in-the-us\", \"file\": \"txt_full/animal-food-production-in-the-us.txt\"}, {\"title\": \"Animal Rescue Shelters\", \"slug\": \"animal-rescue-shelters\", \"file\": \"txt_full/animal-rescue-shelters.txt\"}, {\"title\": \"Antiseptic Manufacturing\", \"slug\": \"antiseptic-manufacturing\", \"file\": \"txt_full/antiseptic-manufacturing.txt\"}, {\"title\": \"Apartment & Condominium Construction in the US\", \"slug\": \"apartment-condominium-construction-in-the-us\", \"file\": \"txt_full/apartment-condominium-construction-in-the-us.txt\"}, {\"title\": \"Apparel Knitting Mills in the US\", \"slug\": \"apparel-knitting-mills-in-the-us\", \"file\": \"txt_full/apparel-knitting-mills-in-the-us.txt\"}, {\"title\": \"Arcade, Food & Entertainment Complexes in the US\", \"slug\": \"arcade-food-entertainment-complexes-in-the-us\", \"file\": \"txt_full/arcade-food-entertainment-complexes-in-the-us.txt\"}, {\"title\": \"Art & Office Supply Manufacturing in the US\", \"slug\": \"art-office-supply-manufacturing-in-the-us\", \"file\": \"txt_full/art-office-supply-manufacturing-in-the-us.txt\"}, {\"title\": \"Art Dealers in the US\", \"slug\": \"art-dealers-in-the-us\", \"file\": \"txt_full/art-dealers-in-the-us.txt\"}, {\"title\": \"Artificial Grass Turf Installation\", \"slug\": \"artificial-grass-turf-installation\", \"file\": \"txt_full/artificial-grass-turf-installation.txt\"}, {\"title\": \"Arts, Entertainment and Recreation in the US\", \"slug\": \"arts-entertainment-and-recreation-in-the-us\", \"file\": \"txt_full/arts-entertainment-and-recreation-in-the-us.txt\"}, {\"title\": \"Athletic & Sporting Goods Manufacturing in the US\", \"slug\": \"athletic-sporting-goods-manufacturing-in-the-us\", \"file\": \"txt_full/athletic-sporting-goods-manufacturing-in-the-us.txt\"}, {\"title\": \"Audio & Video Equipment Distributors\", \"slug\": \"audio-video-equipment-distributors\", \"file\": \"txt_full/audio-video-equipment-distributors.txt\"}, {\"title\": \"Audio & Video Equipment Manufacturing in the US\", \"slug\": \"audio-video-equipment-manufacturing-in-the-us\", \"file\": \"txt_full/audio-video-equipment-manufacturing-in-the-us.txt\"}, {\"title\": \"Audio Production Studios in the US\", \"slug\": \"audio-production-studios-in-the-us\", \"file\": \"txt_full/audio-production-studios-in-the-us.txt\"}, {\"title\": \"Audiobook Publishing\", \"slug\": \"audiobook-publishing\", \"file\": \"txt_full/audiobook-publishing.txt\"}, {\"title\": \"Auto Glass Repair & Replacement Franchises\", \"slug\": \"auto-glass-repair-replacement-franchises\", \"file\":